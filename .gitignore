# ============================================================
# Angular + ASP.NET/.NET Git Ignore
# ============================================================

# ------------------------------------------------------------
# Angular
# ------------------------------------------------------------

# Build output
/dist
/tmp
/out-tsc
/bazel-out

# Angular cache
/.angular/cache

# Node
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
/coverage
testem.log
__screenshots__/

# Misc
.sass-cache/
/typings
/connect.lock
/libpeerconnection.log

# ------------------------------------------------------------
# .NET / Visual Studio
# ------------------------------------------------------------

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/

# Publish output
publish/
wwwroot/dist/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.rsuser
*.sln.docstates

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Rider
.idea/

# JetBrains
*.sln.iml

# ------------------------------------------------------------
# NuGet
# ------------------------------------------------------------

# Restore packages
packages/

# NuGet config secrets
NuGet.Config.user

# ------------------------------------------------------------
# Testing & Coverage
# ------------------------------------------------------------

TestResults/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml

# ------------------------------------------------------------
# Entity Framework
# ------------------------------------------------------------

*.mdf
*.ldf

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log

# ------------------------------------------------------------
